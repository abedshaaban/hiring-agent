# LLM Provider Configuration
# Options: "ollama", "gemini", or "vmlx"
LLM_PROVIDER=ollama

# Default model to use
# For Ollama: "gemma3:4b", "qwen3:4b", "mistral:7b", etc.
# For Gemini: "gemini-2.5-pro", "gemini-2.5-flash", etc.
# For vMLX: use the model name shown by your local vMLX server.
DEFAULT_MODEL=gemma3:4b

# Google Gemini API Key (required if using Gemini provider)
GEMINI_API_KEY=your_gemini_api_key_here

# vMLX local OpenAI-compatible API settings
VMLX_BASE_URL=http://127.0.0.1:8000/v1
VMLX_API_KEY=
VMLX_TIMEOUT=300
